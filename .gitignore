# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
env/
*.egg

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local data override (see DATA.md): never committed, except its README
data/interim/*
!data/interim/README.md

# Large files
*.csv
*.nc
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.parquet
*.feather
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Model files
*.pt
*.pth
*.ckpt
*.joblib

# Data folders (uncomment if needed)
# data/
# datasets/

# Results (uncomment if you don't want to track)
# results/
# outputs/

# Logs
*.log
logs/

# PySR generated files
hall_of_fame*.csv
.SymbolicRegression.jl/

# Experiment run artifacts
hall_of_fame*.csv.bak

# Downloaded dataset archives and derived products (reproduced by
# core/opensense/fetch.py and projects/maps/archive_pipeline/src/ingest_*.py)
dataset/open_datasets/*/raw/
dataset/open_datasets/*/processed/
# files copied out of the OpenMRG archive (fetch.py downloads the originals)
dataset/open_datasets/OpenMRG_Sweden/OpenMRG_Dataset_Paper.pdf
dataset/open_datasets/OpenMRG_Sweden/Torslanda-event-2015-07-28/

# PR write-ups kept locally for review, not published
docs/PRs/

# Local archive of work unrelated to FieldSense, kept out of the repo
other/

# nyc_rain_maps: its intermediate files and run.py outputs, and the study's per-event
# figures (regenerated by run.py study). Its tables are tracked despite *.csv above.
dataset/open_datasets/OpenMesh_NYC/nyc_rain_maps/
projects/maps/nyc/results/study/events/
!projects/maps/nyc/results/**/*.csv
!projects/maps/nyc/events/*.csv

# multisensor_maps and cml_rnn: built datasets, trained models and intermediate files (the
# RNN is rebuilt by projects/retrieval/rnn_three_networks/src/run.py); their result tables are tracked
dataset/open_datasets/_cml_rnn/
dataset/open_datasets/_multisensor_maps/
!projects/maps/multisensor/results/*.csv
!projects/retrieval/rnn_three_networks/results/*.csv
!projects/retrieval/rnn_three_networks/results/**/*.csv

# radar_adjustment: adjusted fields, prepared inputs and the pinned mergeplg; its result
# tables are tracked
dataset/open_datasets/_radar_adjustment/
!projects/maps/radar_adjustment/results/*.csv
!projects/maps/radar_adjustment/results/**/*.csv

# multisensor_nowcasting: cubes, forecasts, models and logs (~9 GB); its result tables are tracked
dataset/open_datasets/_multisensor_nowcasting/
!projects/nowcasting/multisensor/results/*.csv

# os_nowcasting: caches under dataset/open_datasets/_os_nowcasting/ (ignored above); its result tables are tracked
dataset/open_datasets/_os_nowcasting/
!projects/nowcasting/pysteps/results/*.csv

# maps/netherlands: retrieved link rain and maps (no trailing slash: may be a symlink to a
# shared copy); its result tables are tracked
dataset/open_datasets/_netherlands
!projects/maps/netherlands/results/*.csv
