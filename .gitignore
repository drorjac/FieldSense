# Downloaded dataset archives and derived products (reproduced by
# core/opensense/fetch.py and projects/opensense_pipeline/src/ingest_*.py)
dataset/open_datasets/*/raw/
dataset/open_datasets/*/processed/
# files copied out of the OpenMRG archive (fetch.py downloads the originals)
dataset/open_datasets/OpenMRG_Sweden/OpenMRG_Dataset_Paper.pdf
dataset/open_datasets/OpenMRG_Sweden/Torslanda-event-2015-07-28/

# PR write-ups kept locally for review, not published
docs/PRs/

# Local archive of work unrelated to FieldSense, kept out of the repo
other/

# nyc_rain_maps: its intermediate files and run.py outputs, and the study's per-event
# figures (regenerated by run.py study). Its tables are tracked despite *.csv above.
dataset/open_datasets/OpenMesh_NYC/nyc_rain_maps/
projects/nyc_rain_maps/results/study/events/
!projects/nyc_rain_maps/results/**/*.csv
!projects/nyc_rain_maps/events/*.csv
